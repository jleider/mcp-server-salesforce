{
    "name": "@tsmztech/mcp-server-salesforce",
    "version": "0.0.3",
    "description": "A Salesforce connector MCP Server.",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "type": "module",
    "bin": {
      "salesforce-connector": "dist/index.js",
      "salesforce-connector-http": "dist/http-server.js"
    },
    "files": [
      "dist"
    ],
    "scripts": {
      "build": "tsc && shx chmod +x dist/*.js",
      "prepare": "npm run build",
      "watch": "tsc --watch",
      "test": "node --test test/*.test.js",
      "test:integration": "npm run build && node --test test/integration.test.js",
      "test:unit": "node --test test/package.test.js test/repo.guardrails.test.js",
      "start": "node dist/index.js",
      "start:http": "node dist/http-server.js",
      "docker:build": "docker build -t salesforce-mcp-server:streamable-http .",
      "docker:run": "docker run -d --name salesforce-mcp -p 3000:3000 -e MCP_HTTP_HOST=0.0.0.0 --env-file .env salesforce-mcp-server:streamable-http",
      "docker:stop": "docker stop salesforce-mcp && docker rm salesforce-mcp"
    },
    "keywords": [
      "mcp",
      "salesforce",
      "claude",
      "ai"
    ],
    "author": "tsmztech",
    "license": "MIT",
    "dependencies": {
      "@modelcontextprotocol/sdk": "1.17.4",
      "cors": "^2.8.5",
      "dotenv": "^17.2.1",
      "express": "^4.21.2",
      "jsforce": "^3.10.3"
    },
    "devDependencies": {
      "@types/cors": "^2.8.17",
      "@types/express": "^5.0.0",
      "@types/node": "^24.3.0",
      "typescript": "^5.7.2",
      "shx": "^0.4.0"
    }
  }
  